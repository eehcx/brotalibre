---
interface Props {
  locale: string;
  locales: Array<{ code: string; label: string }>;
}

const { locale, locales } = Astro.props;
---

<nav aria-label="Language">
  <ul>
    {locales.map((entry) => (
      <li>
        <a
          href={entry.code === '{{ default_locale }}' ? '/' : `/${entry.code}/`}
          aria-current={entry.code === locale ? 'page' : undefined}
        >
          {entry.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  ul { display: flex; gap: 0.75rem; list-style: none; margin: 0; padding: 0; }
  a[aria-current='page'] { font-weight: 700; }
</style>
