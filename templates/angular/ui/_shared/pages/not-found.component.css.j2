:host {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100%;
  padding: 2rem;
  box-sizing: border-box;
}

.card {
  text-align: center;
}

h1 {
  font-size: 4rem;
  font-weight: 700;
  margin: 0 0 0.5rem;
  letter-spacing: -0.04em;
}

p {
  color: #777;
  margin: 0 0 1.5rem;
  font-size: 1rem;
}

a {
  display: inline-block;
  padding: 0.6rem 1.5rem;
  border-radius: 0.5rem;
  background: #111;
  color: white;
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 500;
  transition: background 0.15s ease;
}

a:hover {
  background: #333;
}
