<style>
  :host {
    display: flex;
    flex-direction: column;
    height: 100dvh;
  }

  .toolbar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 56px;
    padding: 0 1rem;
    background: #111;
    color: white;
    flex-shrink: 0;
    z-index: 10;
    position: relative;
  }

  .toolbar .menu-btn {
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
    padding: 0.4rem;
    border-radius: 0.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .toolbar .menu-btn:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .toolbar .title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .body {
    display: flex;
    flex: 1;
    overflow: hidden;
  }

  .sidenav {
    width: 240px;
    background: #fafafa;
    border-right: 1px solid #eee;
    display: flex;
    flex-direction: column;
    padding: 0.75rem;
    gap: 0.25rem;
    overflow-y: auto;
    transition: width 0.2s ease, padding 0.2s ease;
    flex-shrink: 0;
  }

  .sidenav.collapsed {
    width: 0;
    padding: 0;
    overflow: hidden;
    border: none;
  }

  .sidenav .nav-label {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #999;
    padding: 0.75rem 0.75rem 0.25rem;
  }

  .sidenav a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.4rem;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    color: #555;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .sidenav a:hover {
    background: #eee;
    color: #111;
  }

  .sidenav a.active {
    background: #e8e8e8;
    color: #111;
    font-weight: 600;
  }

  .content {
    flex: 1;
    overflow-y: auto;
    background: #f5f5f5;
  }

  @media (max-width: 768px) {
    .sidenav {
      position: fixed;
      top: 56px;
      left: 0;
      bottom: 0;
      z-index: 20;
      box-shadow: 2px 0 8px rgba(0, 0, 0, 0.1);
    }

    .sidenav.collapsed {
      transform: translateX(-100%);
      width: 240px;
      padding: 0.75rem;
      border-right: 1px solid #eee;
    }

    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.3);
      z-index: 15;
    }

    .overlay.hidden {
      display: none;
    }
  }
</style>

<div class="toolbar">
  <button class="menu-btn" (click)="toggleNav()" aria-label="Toggle navigation">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="6" x2="21" y2="6" />
      <line x1="3" y1="12" x2="21" y2="12" />
      <line x1="3" y1="18" x2="21" y2="18" />
    </svg>
  </button>
  <span class="title">{{ project_name }}</span>
</div>

<div class="body">
  <nav class="sidenav" [class.collapsed]="!navOpen">
    <span class="nav-label">Main</span>
    <a routerLink="/welcome" routerLinkActive="active" [routerLinkActiveOptions]="{ exact: true }">Welcome</a>
    <a routerLink="/dashboard" routerLinkActive="active">Dashboard</a>
  </nav>

  <div class="overlay" [class.hidden]="navOpen || !isMobile()" (click)="navOpen = false"></div>

  <main class="content">
    <router-outlet />
  </main>
</div>
