.detail-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.detail-row {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 12px 0;
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 11px;
  font-weight: 500;
  color: rgba(0, 0, 0, 0.54);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.detail-value {
  font-size: 15px;
  color: rgba(0, 0, 0, 0.87);
  word-break: break-word;
  line-height: 1.4;
}
