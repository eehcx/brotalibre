.form-container {
  padding: 24px;
  max-width: 800px;
  margin: 0 auto;
}

.form-header {
  margin-bottom: 16px;
}

.form-header h1 {
  margin: 8px 0 0;
  font-size: 24px;
  font-weight: 500;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.full-width {
  grid-column: 1 / -1;
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  margin-top: 24px;
  padding-top: 16px;
  border-top: 1px solid rgba(0, 0, 0, 0.12);
}
