import { Component, effect, inject, OnInit, input } from '@angular/core';
import { ReactiveFormsModule, FormBuilder, Validators } from '@angular/forms';
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatInputModule } from '@angular/material/input';
import { MatButtonModule } from '@angular/material/button';
import { MatIconModule } from '@angular/material/icon';
import { MatCardModule } from '@angular/material/card';
import { MatProgressSpinnerModule } from '@angular/material/progress-spinner';
import { Router, RouterModule } from '@angular/router';
import { {{ name }}Store } from '../../application/{{ name_kebab }}.store';
import { {{ name }}Id } from '../../domain/value-objects/{{ name_kebab }}-id.vo';

@Component({
  selector: 'app-{{ name_kebab }}-form',
  imports: [
    ReactiveFormsModule,
    MatFormFieldModule,
    MatInputModule,
    MatButtonModule,
    MatIconModule,
    MatCardModule,
    MatProgressSpinnerModule,
    RouterModule,
  ],
  templateUrl: './{{ name_kebab }}-form.component.html',
  styleUrl: './{{ name_kebab }}-form.component.css',
})
export class {{ name }}FormComponent implements OnInit {
  readonly id = input<string | null>(null);

  readonly #store = inject({{ name }}Store);
  readonly #fb = inject(FormBuilder);
  readonly #router = inject(Router);

  readonly loading = this.#store.loading;
  readonly selected = this.#store.selected;

  readonly form = this.#fb.group({
    {% for field in fields %}
    {{ field.name }}: [
      null as {{ field.type }} | null,
      {% if field.required %}[Validators.required]{% else %}[]{% endif %},
    ],
    {% endfor %}
  });

  constructor() {
    effect(() => {
      const item = this.selected();
      if (item) this.form.patchValue(item as any);
    });
  }

  ngOnInit(): void {
    if (this.id()) {
      this.#store.loadById({{ name }}Id.from(this.id()!));
    }
  }

  onSubmit(): void {
    if (this.form.invalid) return;
    const value = this.form.getRawValue();
    if (this.id()) {
      this.#store.update({ id: {{ name }}Id.from(this.id()!), ...value } as any);
    } else {
      this.#store.create(value as any);
    }
    this.#router.navigate(['{{ route }}']);
  }

  onCancel(): void {
    this.#router.navigate(['{{ route }}']);
  }
}
