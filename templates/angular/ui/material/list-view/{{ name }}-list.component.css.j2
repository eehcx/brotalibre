.list-container {
  padding: 24px;
  max-width: 1200px;
  margin: 0 auto;
}

.spinner-wrapper {
  display: flex;
  justify-content: center;
  padding: 64px 0;
}

.error-message {
  color: #f44336;
  padding: 16px;
  text-align: center;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.list-header h1 {
  margin: 0;
  font-size: 24px;
  font-weight: 500;
}

.search-field {
  width: 100%;
  margin-bottom: 16px;
}

.table-wrapper {
  overflow-x: auto;
}

mat-table {
  width: 100%;
}

mat-header-cell {
  font-weight: 600;
  color: rgba(0, 0, 0, 0.87);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  padding: 48px 16px;
  color: rgba(0, 0, 0, 0.54);
}

.empty-icon {
  font-size: 48px;
  width: 48px;
  height: 48px;
}
